<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting (Android 15+) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">false</item>
        <!-- Disable system bar drawing to prevent deprecated API usage -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_color</item>
        <!-- Edge-to-edge layout for Android 15+ -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>
    
    <!-- Theme applied after Flutter initializes (Android 15+) -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Disable system bar drawing to prevent deprecated API usage -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <!-- Edge-to-edge layout for Android 15+ -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>
</resources>

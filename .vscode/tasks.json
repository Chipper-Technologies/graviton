    {
      "label": "[DEV][ANDROID] Run App",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--dart-define-from-file",
        "config/dev-android.json",
        "--flavor",
        "dev"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Run Flutter app on Android with development configuration"
    },

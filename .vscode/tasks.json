      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Build with Flutter and create Xcode archive for macOS (for App Store or direct distribution)"
    },
    {
      "label": "💿 Export macOS Archive (App Store)",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-exportArchive",
        "-archivePath",
        "build/macos/Graviton.xcarchive",
        "-exportPath",
        "build/macos/AppStore",
        "-exportOptionsPlist",
        "macos/ExportOptions.plist"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": ["📦 Archive macOS (Prod)"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Export archive for App Store distribution (requires ExportOptions.plist)"

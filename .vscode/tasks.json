    },
    {
      "label": "[PROD][MACOS] Export Archive for App Store",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-exportArchive",
        "-archivePath",
        "build/macos/Graviton.xcarchive",
        "-exportPath",
        "build/macos/AppStore",
        "-exportOptionsPlist",
        "macos/ExportOptions.plist"
      ],
      "group": {
        "kind": "build",
        "isDefault": false

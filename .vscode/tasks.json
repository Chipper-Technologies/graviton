    {
      "label": "📦 Archive macOS (Prod)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "flutter build macos --dart-define-from-file config/prod.json --release && xcodebuild -workspace macos/Runner.xcworkspace -scheme prod -configuration Release-prod archive -archivePath build/macos/Graviton.xcarchive"

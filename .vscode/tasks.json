      "args": [
        "-c",
        "flutter build macos --dart-define-from-file config/prod-macos.json --release && xcodebuild -workspace macos/Runner.xcworkspace -scheme prod -configuration Release-prod archive -archivePath build/macos/Graviton.xcarchive"
